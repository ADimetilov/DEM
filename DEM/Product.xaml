<Window x:Class="DEM.Product_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEM"
        mc:Ignorable="d"
        Title="Product" Height="523" Width="404">
    <Grid>
        <Label Content="Продукт" HorizontalAlignment="Center" Margin="0,16,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="NameBox" HorizontalAlignment="Left" Margin="185,47,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label Content="Наименование" HorizontalAlignment="Left" Margin="64,43,0,0" VerticalAlignment="Top"/>
        <Label Content="Описание" HorizontalAlignment="Left" Margin="64,74,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="DescBox" HorizontalAlignment="Left" Margin="185,78,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label Content="Производитель" HorizontalAlignment="Left" Margin="64,105,0,0" VerticalAlignment="Top"/>
        <Label Content="Поставщик" HorizontalAlignment="Left" Margin="64,142,0,0" VerticalAlignment="Top"/>
        <Label Content="Цена" HorizontalAlignment="Left" Margin="64,282,0,0" VerticalAlignment="Top"/>
        <Label Content="Изображение" HorizontalAlignment="Left" Margin="64,356,0,0" VerticalAlignment="Top"/>
        <Button x:Name="ImageSendBut" Content="Выбрать" HorizontalAlignment="Left" Margin="185,358,0,0" VerticalAlignment="Top" Height="22" Width="151" Click="ImageSendBut_Click"/>
        <TextBox x:Name="CostBox" HorizontalAlignment="Left" Margin="185,286,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <TextBox x:Name="SaleBox" HorizontalAlignment="Left" Margin="185,322,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label Content="Скидка" HorizontalAlignment="Left" Margin="64,320,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="SupplierBox" HorizontalAlignment="Left" Margin="185,144,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Supplier1" SelectedValuePath="Id"/>
        <ComboBox x:Name="ManufacterBox" HorizontalAlignment="Left" Margin="185,109,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Manufacter1" SelectedValuePath="Id"/>
        <Button Content="Сохранить" HorizontalAlignment="Center" Margin="0,418,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Label Content="Путь:" HorizontalAlignment="Left" Margin="64,387,0,0" VerticalAlignment="Top"/>
        <Label x:Name="PathImage" Content="" HorizontalAlignment="Left" Margin="185,387,0,0" VerticalAlignment="Top"/>
        <Label Content="На складе" HorizontalAlignment="Left" Margin="64,251,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="ScoreBox" HorizontalAlignment="Left" Margin="185,255,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label x:Name="CategoryText" Content="Категория" HorizontalAlignment="Left" Margin="64,179,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="CategoryBox" HorizontalAlignment="Left" Margin="185,181,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Category1" SelectedValuePath="Id"/>
        <ComboBox x:Name="UnitBox" HorizontalAlignment="Left" Margin="185,217,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Unit1" SelectedValuePath="Id"/>
        <Label x:Name="UnitBlock" Content="Единица измерения" HorizontalAlignment="Left" Margin="64,213,0,0" VerticalAlignment="Top"/>
        <Button x:Name="DeleteButton" Content="Удалить" HorizontalAlignment="Center" Margin="0,453,0,0" VerticalAlignment="Top" Width="62" Click="Button_Click_1"/>
    </Grid>
</Window>
