<Window x:Class="DEM.Product_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEM"
        mc:Ignorable="d"
        Title="Product" Height="523" Width="404">
    <Grid>
        <Label Content="Продукт" HorizontalAlignment="Center" Margin="0,47,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="NameBox" HorizontalAlignment="Left" Margin="185,98,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label Content="Наименование" HorizontalAlignment="Left" Margin="64,94,0,0" VerticalAlignment="Top"/>
        <Label Content="Описание" HorizontalAlignment="Left" Margin="64,125,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="DescBox" HorizontalAlignment="Left" Margin="185,129,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label Content="Производитель" HorizontalAlignment="Left" Margin="64,156,0,0" VerticalAlignment="Top"/>
        <Label Content="Поставщик" HorizontalAlignment="Left" Margin="64,193,0,0" VerticalAlignment="Top"/>
        <Label Content="Цена" HorizontalAlignment="Left" Margin="64,296,0,0" VerticalAlignment="Top"/>
        <Label Content="Изображение" HorizontalAlignment="Left" Margin="64,370,0,0" VerticalAlignment="Top"/>
        <Button x:Name="ImageSendBut" Content="Выбрать" HorizontalAlignment="Left" Margin="185,372,0,0" VerticalAlignment="Top" Height="22" Width="151" Click="ImageSendBut_Click"/>
        <TextBox x:Name="CostBox" HorizontalAlignment="Left" Margin="185,300,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <TextBox x:Name="SaleBox" HorizontalAlignment="Left" Margin="185,336,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label Content="Скидка" HorizontalAlignment="Left" Margin="64,334,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="SupplierBox" HorizontalAlignment="Left" Margin="185,195,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Supplier1" SelectedValuePath="Id"/>
        <ComboBox x:Name="ManufacterBox" HorizontalAlignment="Left" Margin="185,160,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Manufacter1" SelectedValuePath="Id"/>
        <Button Content="Сохранить" HorizontalAlignment="Center" Margin="0,432,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Label Content="Путь:" HorizontalAlignment="Left" Margin="64,401,0,0" VerticalAlignment="Top"/>
        <Label x:Name="PathImage" Content="" HorizontalAlignment="Left" Margin="185,401,0,0" VerticalAlignment="Top"/>
        <Label Content="На складе" HorizontalAlignment="Left" Margin="64,265,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="ScoreBox" HorizontalAlignment="Left" Margin="185,269,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="22"/>
        <Label x:Name="CategoryText" Content="Категория" HorizontalAlignment="Left" Margin="64,230,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="CategoryBox" HorizontalAlignment="Left" Margin="185,232,0,0" VerticalAlignment="Top" Width="151" Height="22" DisplayMemberPath="Category1" SelectedValuePath="Id"/>
    </Grid>
</Window>
