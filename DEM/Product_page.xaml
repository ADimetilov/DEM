<Page x:Class="DEM.Product_page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DEM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Product_page">

    <Grid Background="White">
        <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" Text="Товары" VerticalAlignment="Top" FontSize="26" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Margin="597,14,0,0" TextWrapping="Wrap" Text="Вы вошли как:" VerticalAlignment="Top"/>
        <TextBlock x:Name="UserNameBlock" HorizontalAlignment="Left" Margin="694,14,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>
        <TextBox x:Name="SearchBox" HorizontalAlignment="Left" Margin="597,85,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="193" Height="31"/>
        <TextBlock x:Name="SearchTitile" HorizontalAlignment="Left" Margin="597,59,0,0" TextWrapping="Wrap" Text="Поиск" VerticalAlignment="Top"/>
        <ComboBox x:Name="PostBox" HorizontalAlignment="Left" Margin="597,142,0,0" VerticalAlignment="Top" Width="193" Height="29" DisplayMemberPath="name">

        </ComboBox>
        <TextBlock x:Name="PostTitle" HorizontalAlignment="Left" Margin="597,121,0,0" TextWrapping="Wrap" Text="По поставщикам" VerticalAlignment="Top"/>
        <Button x:Name="AddProduct" Content="Добавить товар" HorizontalAlignment="Left" Margin="597,259,0,0" VerticalAlignment="Top" Height="50" Width="193" Click="AddProduct_Click"/>
        <Button x:Name="Orders" Content="Заказы" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Height="50" Width="193" Click="Orders_Click"/>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="10,3,0,0" VerticalAlignment="Top" Click="Button_Click" Height="27" Width="72" Background="White"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,59,218,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{x:Null}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="2">
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2,2,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <Image VerticalAlignment="Bottom" Width="100" HorizontalAlignment="Stretch" Grid.Column="0"/>
                            </Border>
                            <Border Grid.Column="1" Margin="4,0,0,0" BorderBrush="Gray" BorderThickness="1">
                                <StackPanel Margin="4,0,0,0" Width="300">
                                    <TextBlock><Run  Text="{Binding category}" FontWeight="Bold"  /><Run Text=" "/><Run Text="|"/><Run Text=" "/><Run Text="{Binding name}" FontWeight="Bold"/></TextBlock>
                                    <TextBlock><Run Text="Описание товара:"/><Run Text=" "/><Run Text="{Binding desc}"/></TextBlock>
                                    <TextBlock><Run Text="Поставщик:"/><Run Text=" "/><Run Text="{Binding post}"/></TextBlock>
                                    <TextBlock><Run Text="Цена:"/><Run Text=" "/><Run Text="{Binding cost}"/></TextBlock>
                                    <TextBlock><Run Text="Единица измерения"/><Run Text=" "/><Run Text="{Binding unit}"/></TextBlock>
                                    <TextBlock><Run Text="Количество на складе:"/><Run Text=" "/><Run Text="{Binding score}"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="2,0,0,0" BorderBrush="Black" BorderThickness="1">
                                <TextBlock Width="70"/>
                            </Border>
                        </Grid>
                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="DelProduct" Content="Удалить товар" HorizontalAlignment="Left" Margin="597,324,0,0" VerticalAlignment="Top" Height="50" Width="193" Click="AddProduct_Click"/>
    </Grid>
</Page>
