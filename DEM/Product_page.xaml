<Page x:Class="DEM.Product_page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEM"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Width="800"
        Height="450" >
    <Grid Background="White">
        <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" Text="Товары" VerticalAlignment="Top" FontSize="26" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Margin="597,14,0,0" TextWrapping="Wrap" Text="Вы вошли как:" VerticalAlignment="Top"/>
        <TextBlock x:Name="UserNameBlock" HorizontalAlignment="Left" Margin="694,14,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>
        <TextBox x:Name="SearchBox" HorizontalAlignment="Left" Margin="597,85,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="193" Height="31" TextChanged="SearchBox_TextChanged"/>
        <TextBlock x:Name="SearchTitile" HorizontalAlignment="Left" Margin="597,59,0,0" TextWrapping="Wrap" Text="Поиск" VerticalAlignment="Top"/>
        <ComboBox x:Name="PostBox" HorizontalAlignment="Left" Margin="597,142,0,0" VerticalAlignment="Top" Width="193" Height="29" DisplayMemberPath="name" SelectionChanged="PostBox_SelectionChanged_1">

        </ComboBox>
        <TextBlock x:Name="PostTitle" HorizontalAlignment="Left" Margin="597,121,0,0" TextWrapping="Wrap" Text="По поставщикам" VerticalAlignment="Top"/>
        <Button x:Name="AddProduct" Content="Добавить товар" HorizontalAlignment="Left" Margin="597,324,0,0" VerticalAlignment="Top" Height="50" Width="193" Click="AddProduct_Click"/>
        <Button x:Name="Orders" Content="Заказы" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Height="50" Width="193" Click="Orders_Click"/>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="10,3,0,0" VerticalAlignment="Top" Click="Button_Click" Height="27" Width="72" Background="White"/>
        <ListBox x:Name="ProductListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,59,218,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{x:Null}" SelectionChanged="ProductListBox_SelectionChanged">
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="2">
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2,2,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <Image VerticalAlignment="Bottom" Width="100" HorizontalAlignment="Stretch" Grid.Column="0" Height="110" Stretch="Fill" Source="{Binding PathPhoto, Converter={StaticResource SafeImageConvertor}}">
                                </Image>
                            </Border>
                            <Border Grid.Column="1" Margin="4,0,0,0" BorderBrush="Gray" BorderThickness="1">
                                <StackPanel Margin="4,0,0,0" Width="300">
                                    <TextBlock><Run  Text="{Binding Category.Category1}" FontWeight="Bold"  /><Run Text=" "/><Run Text="|"/><Run Text=" "/><Run Text="{Binding Name}" FontWeight="Bold"/></TextBlock>
                                    <TextBlock><Run Text="Описание товара:"/><Run Text=" "/><Run Text="{Binding Desc}"/></TextBlock>
                                    <TextBlock><Run Text="Производитель:"/><Run Text=" "/><Run Text="{Binding Path = Man.Manufacter1}"/></TextBlock>
                                    <TextBlock><Run Text="Поставщик:"/><Run Text=" "/><Run Text="{Binding Supplier.Supplier1}"/></TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"></ColumnDefinition>
                                            <ColumnDefinition Width="40"></ColumnDefinition>
                                            <ColumnDefinition Width="40"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Цена:"></TextBlock>
                                        <TextBlock Style="{Binding Converter={StaticResource PriceConverter}}" Grid.Column="1"> <Run Name ="OldCost" Text="{Binding Cost}"/></TextBlock>
                                        <TextBlock Grid.Column="2" Visibility="{Binding NewCost,Converter={StaticResource NullToVosibilityConvertor}}"> <Run Name="NewCostText" Text="{Binding NewCost}"/></TextBlock>
                                    </Grid>
                                    <TextBlock><Run Text="Единица измерения"/><Run Text=" "/><Run Text="{Binding Unit.Unit1}"/></TextBlock>
                                    <TextBlock Background="{Binding Score, Converter={StaticResource ScoreProductConvertor}}"><Run Text="Количество на складе:"/><Run Text=" "/><Run Text="{Binding Score}"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="2,0,0,0" BorderBrush="Black" BorderThickness="1">
                                <TextBlock VerticalAlignment="Center" Width ="40" Background="{Binding Sale, Converter={StaticResource BackgroundConverter}}" HorizontalAlignment="Center" Margin="10,10,10,10" >
                                    <Run  Name ="Sale" Text="{Binding Sale}"/>
                                    <Run Text="%"></Run>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <RadioButton x:Name="UpSortChecker" Content="По возрастанию" HorizontalAlignment="Left" Margin="425,39,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked" Click="UpSortChecker_Click"/>
        <RadioButton x:Name="DownSortChecker" Content="По убыванию" HorizontalAlignment="Left" Margin="325,39,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked" Click="DownSortChecker_Click"/>
        <RadioButton x:Name ="NoSort" Content="Нет" HorizontalAlignment="Left" Margin="281,39,0,0" VerticalAlignment="Top" IsChecked="True" Checked="RadioButton_Checked_1"/>
    </Grid>
</Page>
