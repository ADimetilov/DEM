<Page x:Class="DEM.Order_page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEM"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Title="Orders">
    <Grid Background="White">
        <ListBox x:Name="OrderList" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,44,193,52" BorderBrush="{x:Null}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="Gray" BorderThickness="1">
                                <StackPanel  Margin="6,0,0,0" Width="400">
                                    <TextBlock>
                                    <Run Text="{Binding Path=Art}" FontWeight="Bold"></Run>
                                    </TextBlock>
                                    <TextBlock>
                                    <Run Text="{Binding Path=Status.Status1}"/>
                                    </TextBlock>
                                    <TextBlock>
                                    <Run Text="Адрес пункта выдачи:"/>
                                    <Run Text="{Binding Path=Adres}"/>
                                    </TextBlock>
                                    <TextBlock>
                                    <Run Text="{Binding Path=DateStart}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Width="100" Margin="2,0,0,0">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Run Text="{Binding Path=DateEnd}"></Run>
                                </TextBlock>
                            </Border>
                        </Grid>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Заказы" VerticalAlignment="Top" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold"/>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="10,8,0,0" VerticalAlignment="Top" Height="27" Width="58" Background="White" Click="Button_Click"/>
        <Button Content="Добавить заказ" HorizontalAlignment="Right" Margin="0,44,30,0" VerticalAlignment="Top" Height="45" Width="144" Click="Button_Click_1"/>
        <Button Content="Удалить заказ" HorizontalAlignment="Right" Margin="0,106,30,0" VerticalAlignment="Top" Height="45" Width="144"/>

    </Grid>
</Page>
