<Application x:Class="DEM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DEM"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:BackgroundConverter x:Key="BackgroundConverter"/>
        <local:PriceConverter x:Key="PriceConverter"/>
        <local:NullToVosibilityConvertor x:Key="NullToVosibilityConvertor"/>
        <local:ScoreProductConvertor x:Key="ScoreProductConvertor"/>
        <local:SafeImageConverter x:Key="SafeImageConvertor"/>
    </Application.Resources>
</Application>
